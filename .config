#
# ===== Target: x86 / 64 =====
#
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_Generic=y
CONFIG_TARGET_DEVICE_x86_64_DEVICE_generic=y

#
# ===== Target Images：EFI + squashfs + gzip，根分区 2GB =====
#
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y
CONFIG_ISO_IMAGES=n
CONFIG_QCOW2_IMAGES=n
CONFIG_VDI_IMAGES=n
CONFIG_VMDK_IMAGES=n
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=2048
CONFIG_GRUB_TITLE="ImmortalWrt"
CONFIG_GRUB_TIMEOUT="3"

#
# ===== 基础 / Web UI =====
#
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lua-runtime=y
CONFIG_PACKAGE_luci-app-package-manager=y

#
# ===== 你要求的插件 =====
#
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-snmpd=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-uugamebooster=y

#
# ===== 主题：Material =====
#
CONFIG_PACKAGE_luci-theme-material=y

#
# ===== TCP 拥塞控制（BBR）+ 队列调度 =====
#
# kmod-tcp-bbr: 内核 CONFIG_TCP_CONG_BBR -> tcp_bbr.ko，包自带
#   /etc/sysctl.d/12-tcp-bbr.conf（开机把 cc 设成 bbr）
# kmod-sched: 内核 CONFIG_NET_SCH_FQ -> sch_fq.ko（BBR 推荐的 fq 队列）
# luci-app-tcpcc: 网络 -> TCP 拥塞控制 开关页（可切 cubic/bbr）
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-sched=y
CONFIG_PACKAGE_luci-app-tcpcc=y

#
# ===== 常用工具（可选）=====
#
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_luci-app-commands=y

#
# ===== Tailscale（组网 / 出口节点）=====
#
# tailscale 1.104.1：Go 源码编（host golang1.27），依赖 ca-bundle + kmod-tun
# kmod-tun 必须显式选：上游 generic config 不带，不选则 tailscaled 起不来
# luci-app-tailscale-community：上游 luci feed 提供，网页看节点状态/配置
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_luci-app-tailscale-community=y
